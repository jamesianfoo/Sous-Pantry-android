# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
PORT=3000
NODE_ENV=development

# RevenueCat REST API secret key (v2 secret from RevenueCat dashboard)
# Required for promo code redemption to grant promotional entitlements
REVENUECAT_SECRET_KEY=sk_YOUR_SECRET_KEY_HERE

# Supabase — used by middleware/requireAuth.js to verify iOS client JWTs
# Dashboard: Project Settings → API
# SUPABASE_URL              = Project URL (e.g. https://xxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY = service_role secret (NEVER expose to the client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
